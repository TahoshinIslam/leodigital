# Copy to .env.local and fill in. Never commit .env.local.

# ── Site ────────────────────────────────────────────────────────────────
# Public origin, used for canonical URLs, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── MySQL / MariaDB (XAMPP defaults: user root, empty password, port 3306)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=leodigital
DB_POOL_SIZE=10

# ── Auth ────────────────────────────────────────────────────────────────
# Session lifetime in hours.
SESSION_TTL_HOURS=12

# First super admin, created by `npm run db:setup` (only if the email is new).
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@leotechbd.com
SEED_ADMIN_PASSWORD=change-me-to-a-long-passphrase

# ── Security ────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the public JSON API cross-origin
# (e.g. a mobile app or partner site). Leave empty to disable CORS.
CORS_ALLOWED_ORIGINS=

# ── Uploads ─────────────────────────────────────────────────────────────
# Where admin-uploaded images are stored (outside /public so they are
# served through /media with validation and long-lived cache headers).
UPLOAD_DIR=./storage/uploads
UPLOAD_MAX_MB=5
